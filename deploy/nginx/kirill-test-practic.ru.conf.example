# Enable only after issuing the certificate for both hostnames.
server {
    listen 80;
    listen [::]:80;
    server_name kirill-test-practic.ru www.kirill-test-practic.ru;
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://kirill-test-practic.ru$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.kirill-test-practic.ru;
    ssl_certificate /etc/letsencrypt/live/kirill-test-practic.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/kirill-test-practic.ru/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    return 301 https://kirill-test-practic.ru$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name kirill-test-practic.ru;
    ssl_certificate /etc/letsencrypt/live/kirill-test-practic.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/kirill-test-practic.ru/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header X-Robots-Tag "noindex, nofollow, noarchive, nosnippet" always;
    location / {
        proxy_pass http://127.0.0.1:8181;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
