# Enable only after kirill-test-practic.ru resolves to 168.222.193.85.
# Copy to /etc/nginx/sites-available/kirill-test-practic.ru and create a symlink in sites-enabled.
# Issue the certificate with certbot, then enable the HTTPS server below.

server {
    listen 80;
    listen [::]:80;
    server_name www.kirill-test-practic.ru;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 http://kirill-test-practic.ru$request_uri;
    }
}

server {
    listen 80;
    listen [::]:80;
    server_name kirill-test-practic.ru;

    add_header X-Robots-Tag "noindex, nofollow, noarchive, nosnippet" always;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        proxy_pass http://127.0.0.1:8181;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

